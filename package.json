{
  "name": "buns-the-game",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:mobile": "node scripts/mobile-test.mjs",
    "test:loop": "node scripts/loop-test.mjs",
    "test:world": "node scripts/world-test.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "assets:sizes": "node scripts/dump-world-sizes.mjs",
    "assets:art": "cd tools/hearthwood && python3 build_all.py",
    "assets:sheet": "cd tools/hearthwood && python3 contact_sheet.py",
    "assets:pack": "node scripts/pack-atlases.mjs",
    "art:check": "node scripts/check-hand-art.mjs",
    "art:ramps": "cd tools/hearthwood && python3 dump_ramps.py ramps.json",
    "art:palette": "node scripts/make-palette-files.mjs",
    "art:brief": "npm run art:ramps && node scripts/make-art-brief.mjs && npm run art:palette",
    "assets:all": "npm run assets:sizes && npm run assets:art && npm run assets:pack && npm run assets:sheet && npm run audit:assets",
    "assets:generate": "node scripts/generate-all.mjs",
    "assets:process": "node scripts/process-asset.mjs",
    "build:static": "STATIC_EXPORT=1 next build"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "playwright-core": "^1.63.0",
    "process": "^0.11.10",
    "sharp": "^0.35.4",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "description": "A top-down 2D survival game: gather, craft, smelt, farm and survive a day/night cycle."
}
